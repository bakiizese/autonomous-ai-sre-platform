# Primary AI Core
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-2.5-flash

# GitHub Automation
GITHUB_TOKEN=your_github_token_here
# Comma-separated list of repos the platform can write to (branch/commit/PR).
# Any other public repo a visitor connects is read-only inspection only.
SANDBOX_REPOS=bakiizese/sentinel-sre-playground

# App Configuration
PORT=8000
DATABASE_URL=postgresql+psycopg://sre:sre@localhost:5433/sre
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

POLL_INTERVAL_SECONDS=30
CRITICAL_RISK_THRESHOLD=8
AGENT_MAX_FIX_RETRIES=1

# Public-demo abuse protection (0 disables a limit)
RATE_LIMIT_COSTLY_PER_10MIN=6   # per visitor: inject / triage / scratchpad / verify
RATE_LIMIT_LIGHT_PER_10MIN=30   # per visitor: connect / refresh / subscribe / context
DAILY_RUN_CAP=50                # total pipeline runs per rolling 24h, from any source

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=senderemailuser@gmail.com
SMTP_PASSWORD=16-char-gmail-app-password
ADMIN_ALERT_EMAIL=targetemailuser@gmail.com
